# Sinhron operator server — environment template.
# Copy to `.env` and fill in. `.env` is gitignored — never commit secrets.

# Bind address. Use 127.0.0.1:8080 behind a reverse proxy (Caddy/nginx);
# 0.0.0.0:8080 for direct exposure (NOT recommended without TLS).
SINHRON_LISTEN=0.0.0.0:8080

# PostgreSQL connection URL. For local docker compose stack:
SINHRON_DB_URL=postgres://sinhron:dev_only@localhost:5433/sinhron

# Logging verbosity. `info` default; bump to `debug` per-module for
# troubleshooting (e.g. `RUST_LOG=info,sinhron_server=debug,sqlx=warn`).
RUST_LOG=info

# Message retention in days (texts and chat invitations wait this long for a
# phone that is away). Default 365 (owner, 2026-11-02; the spec had 14).
SINHRON_MESSAGE_RETENTION_DAYS=365

# Max size of one encrypted media blob, bytes (ADR-017). Default 100 MiB.
# SINHRON_MEDIA_MAX_BYTES=104857600
# All stored media together, bytes (default 50 GiB). Lower it on a small disk:
# uploads past it are refused until old media expires.
# SINHRON_MEDIA_TOTAL_BYTES=53687091200

# Sweep cadence in seconds for the retention worker (WU A9). Default 3600.
# SINHRON_RETENTION_SWEEP_SECS=3600

# Postgres pool + rate limits (all optional; empty/unset = defaults).
# SINHRON_PG_MAX_CONNS=16
# SINHRON_PG_ACQUIRE_TIMEOUT_SECS=5
# SINHRON_RATE_REGISTER=5/3600      # N requests per W seconds
# SINHRON_RATE_KP_UPLOAD=100/3600
# SINHRON_RATE_SUBMIT=600/60
# SINHRON_RATE_MEDIA_UPLOAD=200/3600
# ADR-071 — message requests (no access key): deliveries per sender→recipient,
# request pushes per person and per sender→recipient.
# SINHRON_RATE_REQUESTS=60/60
# SINHRON_RATE_REQUEST_PUSH=10/3600
# SINHRON_RATE_REQUEST_PUSH_PAIR=1/600
# WS idle watchdog, seconds (min 15; clients heartbeat every 20 s; an Android
# phone in the background asks for up to 300 s per session). Default 45.
# SINHRON_WS_IDLE_TIMEOUT_SECS=75

# Optional PgBouncer (docker compose, tech-debt 2.13). Migrations still go
# straight to Postgres (SINHRON_DB_MIGRATE_URL, set by compose).
# COMPOSE_PROFILES=pgbouncer
# SINHRON_DB_HOST=pgbouncer
# PGBOUNCER_MAX_CLIENT_CONN=1000
# PGBOUNCER_POOL_SIZE=20

# ─── docker-compose-specific (WU A11) ────────────────────────────────

# Public DNS names — all three need A/AAAA records to this server;
# Caddy provisions a Let's Encrypt cert for each (HTTP-01 on port 80).
# API + WS. The server takes only signatures that name it (ADR-086).
SINHRON_PUBLIC_HOSTNAME=cabin.example.com            # API + WS
SINHRON_LIVEKIT_HOSTNAME=livekit.cabin.example.com   # wss:// call signaling
SINHRON_TURN_HOSTNAME=turn.cabin.example.com         # TURN over TLS on 443

# Postgres password — MUST be set to a strong random in production.
SINHRON_DB_PASSWORD=change-me-before-prod

# Server image tag (matches Cargo.toml package version).
SINHRON_VERSION=0.1.0

# ─── Calls: LiveKit SFU + coturn TURN (WU CA1-CA4) ───────────────────
#
# These secrets MUST be replaced before any non-local deploy. NEVER
# commit real values to git.

# LiveKit auth keys — format is "<key>: <secret>" (space after colon).
# Generate via:
#   echo "$(openssl rand -hex 16): $(openssl rand -base64 32)"
# `key` part is the API key (becomes JWT `iss` claim), `secret` is
# used to sign JWTs server-side. Keep this exact format — LiveKit
# server parses it on startup.
LIVEKIT_KEYS=devkey: devsecret_at_least_32_chars_for_dev_only_replace_in_prod_with_real

# LiveKit URL handed to clients by /v1/call/token. Production compose
# derives it: wss://${SINHRON_LIVEKIT_HOSTNAME}. Only the local-dev
# override reads this — set ws://<Mac LAN IP>:7880 for on-device tests.
LIVEKIT_URL=ws://localhost:7880

# coturn shared secret for REST-API credential mint (RFC 5766). The
# server HMAC-SHA1s a per-user `username` with this secret to produce
# a `credential` valid for `TURN_TTL_SECS`. Generate via:
#   openssl rand -hex 32
TURN_SHARED_SECRET=devturnsecret_replace_in_production_with_strong_random_value

# Authentication realm (appears in TURN auth attribute). Match your
# server hostname for production deploys.
TURN_REALM=sinhron

# TURN credential TTL in seconds (default 86400 = 24h, max 86400).
# coturn re-validates the credential on every allocation refresh and
# there is no mid-call re-mint, so this bounds the longest call.
# TURN_TTL_SECS=86400

# Public-facing TURN URLs that the server hands to clients, tried in
# order by ICE. Keep all three in production: UDP (best), TCP 3478, and
# TLS on 443 through Caddy for networks that only allow HTTPS.
#   TURN_URLS=turn:cabin.example.com:3478?transport=udp,turn:cabin.example.com:3478?transport=tcp,turns:turn.cabin.example.com:443?transport=tcp
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp

# Public IP coturn advertises in relay candidates. The server's public
# IP; behind 1:1 NAT (public IP not on the interface — Yandex Cloud,
# AWS EIP, …) use "<public>/<private>". Wrong value = relays silently
# fail. Local dev: 127.0.0.1 (override ignores it anyway).
TURN_EXTERNAL_IP=127.0.0.1

# ─── Telegram sticker packs by link (ADR-062) ─────────────────────────
# Off until the bot token from @BotFather is in a file on the host:
#   sudo install -d -m 700 -o 10001 /etc/sinhron/telegram
#   sudo sh -c 'printf %s "<token>" > /etc/sinhron/telegram/bot-token'
#   sudo chown 10001 /etc/sinhron/telegram/bot-token && sudo chmod 400 /etc/sinhron/telegram/bot-token
#   docker compose up -d sinhron-server
# Another Bot API endpoint, when api.telegram.org is unreachable from the
# server (a self-hosted telegram-bot-api abroad):
# SINHRON_TELEGRAM_API_URL=https://bot-api.example.org
# Per account: pack lists / files per window (N/seconds).
# SINHRON_RATE_TG_PACKS=30/3600
# SINHRON_RATE_TG_FILES=3000/3600
